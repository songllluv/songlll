---
import Html from "../layouts/Html.astro";
import { marked } from "marked";
import { getCollection } from "astro:content";

const postList = await getCollection("articles");

const aboutmd = `
关于 [我](./articles/aboutme)
`;
const about: string = await marked(aboutmd);

const games = [
    {
        name: "OI Remake Game",
        path: "oi-remake-game",
        entry: "index.html",
        readme: true,
        license: true,
    },
    {
        name: "Oier 高考复健模拟器",
        path: "oier-gaokao-recovery-simulator",
        entry: "index.html",
        readme: true,
        license: false,
    },
    {
        name: "OI 模拟器",
        path: "oimoniqi",
        entry: "index.html",
        readme: true,
        license: false,
    },
    {
        name: "OI Race Simulation",
        path: "OIRaceSimulation",
        entry: "index.html",
        readme: true,
        license: true,
    },
    {
        name: "OItrainer",
        path: "OItrainer",
        entry: "index.html",
        readme: true,
        license: true,
    },
    {
        name: "VR OI Simulator",
        path: "vr-oi-simulator",
        entry: "index.html",
        readme: true,
        license: true,
    },
    {
        name: "WHK-LXY",
        path: "whk-LXY",
        entry: "New-whk-safe.html",
        readme: false,
        license: false,
    },
];
---

<Html title="Songlll 导航页" enableHighlight>
    <div slot="header">导航页</div>

    <div class="card">
        <h1>文章列表</h1>
        <ul id="list">
            {postList.map((post) => (
                <li>
                    <a href={`/articles/${post.slug}/`}>{post.data.title}</a>
                </li>
            ))}
        </ul>
        <br />
    </div>

    <script>
        const showPages = Number(localStorage.getItem("showPages")) || 1;
        const list = document.getElementById("list");
        const items = list?.getElementsByTagName("li") || [];
        let count = 0;
        const showCountBegin = (showPages - 1) * 10;
        const showCountEnd = showPages * 10 - 1;

        for (const item of items) {
            count++;
            if (count > showCountEnd || count <= showCountBegin) {
                item.style.display = "none";
            }
        }
    </script>

    <div class="card">
        <h1>游戏</h1>
        <ul id="pages">
            {games.map((game) => (
                <li>
                    <a href={`/repost/${game.path}/${game.entry}`}>
                        {game.name}
                    </a>
                    <span style="margin-left: 8px; font-size: 12px;">
                        {game.readme && (
                            <a href={`/repost-docs/${game.path}/README`}>[README]</a>
                        )}
                        {game.license && (
                            <a href={`/repost-docs/${game.path}/LICENSE`}>[LICENSE]</a>
                        )}
                    </span>
                </li>
            ))}
        </ul>
    </div>

    <div class="card" set:html={about}></div>

    <script type="module">
        import { showDialog } from "/index.js";
    </script>
</Html>
