---
import { readFile } from "node:fs/promises";
import path from "node:path";
import MarkdownIt from "markdown-it";
import markdownItKatex from "markdown-it-katex";
import MarkdownLayout from "../../../layouts/Markdown.astro";

export async function getStaticPaths() {
    const projects = [
        { slug: "oi-remake-game", name: "OI Remake Game", docs: ["README", "LICENSE"] },
        { slug: "oier-gaokao-recovery-simulator", name: "Oier 高考复健模拟器", docs: ["README"] },
        { slug: "oimoniqi", name: "OI 生涯模拟器", docs: ["README"] },
        { slug: "OIRaceSimulation", name: "OI Race Simulation", docs: ["README", "LICENSE"] },
        { slug: "OItrainer", name: "OItrainer", docs: ["README", "LICENSE"] },
        { slug: "vr-oi-simulator", name: "VR OI Simulator", docs: ["README", "LICENSE"] },
    ];

    return projects.flatMap((project) =>
        project.docs.map((doc) => ({
            params: {
                project: project.slug,
                doc,
            },
            props: {
                projectName: project.name,
            },
        }))
    );
}

const project = Astro.params.project!;
const doc = Astro.params.doc!;
const { projectName } = Astro.props;

const fileName = doc === "README" ? "README.md" : "LICENSE";
const isAppProject = project === "oier-gaokao-recovery-simulator";
const filePath = isAppProject
    ? path.join(process.cwd(), "apps", project, fileName)
    : path.join(process.cwd(), "public", "repost", project, fileName);
const source = await readFile(filePath, "utf-8");

const sourceHref = isAppProject
    ? `https://github.com/songllluv/songlll/blob/main/apps/${project}/${fileName}`
    : `/repost/${project}/${fileName}`;

const markdown = new MarkdownIt({
    html: false,
    linkify: true,
    typographer: false,
});

markdown.use(markdownItKatex, {
    throwOnError: false,
});

// README 中的相对链接和图片应以原项目目录为基准，而不是文档页面的 URL。
function resolveProjectUrl(value: string): string {
    if (
        !value ||
        value.startsWith("#") ||
        value.startsWith("/") ||
        /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(value)
    ) {
        return value;
    }

    const resolved = new URL(
        value,
        `https://songlll.invalid/repost/${encodeURIComponent(project)}/`
    );
    return `${resolved.pathname}${resolved.search}${resolved.hash}`;
}

markdown.core.ruler.after("inline", "resolve-repost-relative-urls", (state) => {
    for (const block of state.tokens) {
        if (block.type !== "inline" || !block.children) continue;

        for (const token of block.children) {
            if (token.type === "link_open") {
                const href = token.attrGet("href");
                if (!href) continue;

                token.attrSet("href", resolveProjectUrl(href));

                if (/^https?:\/\//i.test(href) || href.startsWith("//")) {
                    token.attrSet("target", "_blank");
                    token.attrSet("rel", "noopener noreferrer");
                }
            } else if (token.type === "image") {
                const src = token.attrGet("src");
                if (src) token.attrSet("src", resolveProjectUrl(src));
            }
        }
    }
});

const renderedContent = markdown.render(source);
---

<MarkdownLayout
    title={`${projectName} · ${doc}`}
    content={renderedContent}
    backHref={`/repost/${project}/`}
    sourceHref={sourceHref}
/>
